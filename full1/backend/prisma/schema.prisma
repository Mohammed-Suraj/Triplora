// Triplora - AI Powered Kerala Tourism Platform
// Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum BudgetType {
  RELAXED
  PREMIUM
  LUXURY
}

enum TravelStyle {
  ROMANTIC
  FAMILY
  SOLO
  FRIENDS
}

enum ContactStatus {
  NEW
  READ
  RESPONDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum EmailType {
  WELCOME
  VERIFICATION
  FORGOT_PASSWORD
  PASSWORD_RESET
  BOOKING_CONFIRMATION
  PAYMENT_SUCCESS
  BOOKING_CANCELLED
  AI_TRIP_SAVED
  TRIP_REMINDER
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum AiRole {
  USER
  ASSISTANT
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_SUCCESS
  TRIP_REMINDER
  WISHLIST_UPDATE
  ADMIN_ANNOUNCEMENT
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  password           String
  avatar             String?
  role               Role     @default(USER)
  bookingEmails      Boolean  @default(true)
  marketingEmails    Boolean  @default(true)
  aiPlannerEmails    Boolean  @default(true)
  tripReminderEmails Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  wishlists    Wishlist[]
  tripPlans    TripPlan[]
  reviews      Review[]
  bookings     Booking[]
  aiConversations AiConversation[]
  reviewLikes      ReviewLike[]
  reviewReports    ReviewReport[]
  notifications    Notification[]
  searchLogs       SearchLog[]
  aiUsageLogs      AiUsageLog[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Email logs
// ---------------------------------------------------------------------------

model EmailLog {
  id        String      @id @default(uuid())
  to        String
  type      EmailType
  subject   String
  html      String    @default("")
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  error     String?
  sentAt    DateTime?
  metadata  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([type])
  @@index([to])
  @@map("email_logs")
}

// ---------------------------------------------------------------------------
// Category
// ---------------------------------------------------------------------------

model Category {
  id           String   @id @default(uuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  destinations Destination[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// Destination
// ---------------------------------------------------------------------------

model Destination {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  tagline         String
  region          String
  image           String
  gallery         String[] @default([])
  rating          Float    @default(0)
  reviewsCount    Int      @default(0)
  popularityScore Int      @default(0)
  priceFrom       Int
  latitude        Float?
  longitude       Float?
  duration        String
  bestSeason      String
  description     String
  longDescription String
  highlights      String[] @default([])
  activities      String[] @default([])
  isFeatured      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  reviews         Review[]
  itineraryItems  Itinerary[]
  wishlistedBy    Wishlist[]
  bookings        Booking[]

  @@index([categoryId])
  @@index([region])
  @@map("destinations")
}

// ---------------------------------------------------------------------------
// Wishlist  (User <-> Destination, many-to-many via join model)
// ---------------------------------------------------------------------------

model Wishlist {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())

  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
  @@index([userId])
  @@map("wishlists")
}

// ---------------------------------------------------------------------------
// TripPlan
// ---------------------------------------------------------------------------

model TripPlan {
  id          String        @id @default(uuid())
  title       String?
  budget      BudgetType    @default(RELAXED)
  days        Int
  travelStyle TravelStyle   @default(SOLO)
  interests   String[]      @default([])
  // Complete AI-generated itinerary (title, summary, weather, packing, tips,
  // emergency contacts, budget and every per-day section). Stored so saved
  // trips can be re-rendered exactly and exported to PDF later.
  payload     Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  itinerary   Itinerary[]

  @@index([userId])
  @@map("trip_plans")
}

// ---------------------------------------------------------------------------
// Itinerary (day-by-day items belonging to a TripPlan, each pointing at a Destination)
// ---------------------------------------------------------------------------

model Itinerary {
  id            String   @id @default(uuid())
  day           Int
  focus         String
  notes         String?
  createdAt     DateTime @default(now())

  tripPlanId    String
  tripPlan      TripPlan    @relation(fields: [tripPlanId], references: [id], onDelete: Cascade)

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@index([tripPlanId])
  @@index([destinationId])
  @@map("itineraries")
}

// ---------------------------------------------------------------------------
// Review
// ---------------------------------------------------------------------------

model Review {
  id            String   @id @default(uuid())
  rating        Int
  comment       String
  images        String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  likes         ReviewLike[]
  reports       ReviewReport[]

  @@unique([userId, destinationId])
  @@index([destinationId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// ReviewLike - one user can like a review once
// ---------------------------------------------------------------------------

model ReviewLike {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  reviewId  String
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@map("review_likes")
}

// ---------------------------------------------------------------------------
// ReviewReport - users flag problematic reviews, admins moderate them
// ---------------------------------------------------------------------------

model ReviewReport {
  id        String       @id @default(uuid())
  reason    String
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())

  reviewId  String
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([status])
  @@map("review_reports")
}

// ---------------------------------------------------------------------------
// AiConversation / AiMessage - persisted AI Travel Assistant chat history
// ---------------------------------------------------------------------------

model AiConversation {
  id        String   @id @default(uuid())
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages  AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  role           AiRole
  content        String
  createdAt      DateTime @default(now())

  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

// ---------------------------------------------------------------------------
// Notification - in-app notifications (bookings, payments, reminders, admin)
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// SearchLog - tracks user queries for "most searched" analytics
// ---------------------------------------------------------------------------

model SearchLog {
  id        String   @id @default(uuid())
  query     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([query])
  @@map("search_logs")
}

// ---------------------------------------------------------------------------
// AiUsageLog - tracks AI feature usage for the analytics dashboard
// ---------------------------------------------------------------------------

model AiUsageLog {
  id        String   @id @default(uuid())
  type      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("ai_usage_logs")
}

// ---------------------------------------------------------------------------
// Booking
// ---------------------------------------------------------------------------

model Booking {
  id                String        @id @default(uuid())
  bookingId         String        @unique
  fullName          String
  email             String
  phone             String
  numberOfTravelers Int
  travelDate        DateTime
  returnDate        DateTime?
  budget            Float
  specialRequests   String?
  status            BookingStatus  @default(PENDING)
  paymentStatus     PaymentStatus  @default(PENDING)
  paymentId         String?
  orderId           String?
  amount            Float?
  currency          String?        @default("INR")
  paidAt            DateTime?
  paymentMethod     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  destinationId     String
  destination       Destination   @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@unique([userId, destinationId, travelDate])
  @@index([userId])
  @@index([destinationId])
  @@index([status])
  @@index([paymentStatus])
  @@map("bookings")
}

// ---------------------------------------------------------------------------
// ContactMessage
// ---------------------------------------------------------------------------

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@map("contact_messages")
}
