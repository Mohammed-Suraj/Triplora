// Triplora - AI Powered Kerala Tourism Platform
// Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum BudgetType {
  RELAXED
  PREMIUM
  LUXURY
}

enum TravelStyle {
  ROMANTIC
  FAMILY
  SOLO
  FRIENDS
}

enum ContactStatus {
  NEW
  READ
  RESPONDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum EmailType {
  WELCOME
  VERIFICATION
  FORGOT_PASSWORD
  PASSWORD_RESET
  BOOKING_CONFIRMATION
  PAYMENT_SUCCESS
  BOOKING_CANCELLED
  AI_TRIP_SAVED
  TRIP_REMINDER
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum AiRole {
  USER
  ASSISTANT
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum HotelType {
  HOTEL
  RESORT
  VILLA
  HOMESTAY
  BACKPACKER
}

enum HotelBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_SUCCESS
  TRIP_REMINDER
  WISHLIST_UPDATE
  ADMIN_ANNOUNCEMENT
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  password           String
  avatar             String?
  role               Role     @default(USER)
  bookingEmails      Boolean  @default(true)
  marketingEmails    Boolean  @default(true)
  aiPlannerEmails    Boolean  @default(true)
  tripReminderEmails Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  wishlists    Wishlist[]
  tripPlans    TripPlan[]
  plannerTrips PlannerTrip[]
  reviews      Review[]
  bookings     Booking[]
  hotelBookings HotelBooking[]
  hotelReviews  HotelReview[]
  aiConversations AiConversation[]
  reviewLikes      ReviewLike[]
  reviewReports    ReviewReport[]
  notifications    Notification[]
  searchLogs       SearchLog[]
  aiUsageLogs      AiUsageLog[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Email logs
// ---------------------------------------------------------------------------

model EmailLog {
  id        String      @id @default(uuid())
  to        String
  type      EmailType
  subject   String
  html      String    @default("")
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  error     String?
  sentAt    DateTime?
  metadata  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([type])
  @@index([to])
  @@map("email_logs")
}

// ---------------------------------------------------------------------------
// Category
// ---------------------------------------------------------------------------

model Category {
  id           String   @id @default(uuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  destinations Destination[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// Destination
// ---------------------------------------------------------------------------

model Destination {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  tagline         String
  region          String
  image           String
  gallery         String[] @default([])
  rating          Float    @default(0)
  reviewsCount    Int      @default(0)
  popularityScore Int      @default(0)
  priceFrom       Int
  latitude        Float?
  longitude       Float?
  duration        String
  bestSeason      String
  description     String
  longDescription String
  highlights      String[] @default([])
  activities      String[] @default([])
  isFeatured      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  reviews         Review[]
  itineraryItems  Itinerary[]
  wishlistedBy    Wishlist[]
  bookings        Booking[]
  hotels          Hotel[]

  @@index([categoryId])
  @@index([region])
  @@map("destinations")
}

// ---------------------------------------------------------------------------
// Wishlist  (User <-> Destination, many-to-many via join model)
// ---------------------------------------------------------------------------

model Wishlist {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())

  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
  @@index([userId])
  @@map("wishlists")
}

// ---------------------------------------------------------------------------
// TripPlan
// ---------------------------------------------------------------------------

model TripPlan {
  id          String        @id @default(uuid())
  title       String?
  budget      BudgetType    @default(RELAXED)
  days        Int
  travelStyle TravelStyle   @default(SOLO)
  interests   String[]      @default([])
  // Complete AI-generated itinerary (title, summary, weather, packing, tips,
  // emergency contacts, budget and every per-day section). Stored so saved
  // trips can be re-rendered exactly and exported to PDF later.
  payload     Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  itinerary   Itinerary[]

  @@index([userId])
  @@map("trip_plans")
}

// ---------------------------------------------------------------------------
// Itinerary (day-by-day items belonging to a TripPlan, each pointing at a Destination)
// ---------------------------------------------------------------------------

model Itinerary {
  id            String   @id @default(uuid())
  day           Int
  focus         String
  notes         String?
  createdAt     DateTime @default(now())

  tripPlanId    String
  tripPlan      TripPlan    @relation(fields: [tripPlanId], references: [id], onDelete: Cascade)

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@index([tripPlanId])
  @@index([destinationId])
  @@map("itineraries")
}

// ---------------------------------------------------------------------------
// Review
// ---------------------------------------------------------------------------

model Review {
  id            String   @id @default(uuid())
  rating        Int
  comment       String
  images        String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  likes         ReviewLike[]
  reports       ReviewReport[]

  @@unique([userId, destinationId])
  @@index([destinationId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// ReviewLike - one user can like a review once
// ---------------------------------------------------------------------------

model ReviewLike {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  reviewId  String
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
  @@map("review_likes")
}

// ---------------------------------------------------------------------------
// ReviewReport - users flag problematic reviews, admins moderate them
// ---------------------------------------------------------------------------

model ReviewReport {
  id        String       @id @default(uuid())
  reason    String
  status    ReportStatus @default(OPEN)
  createdAt DateTime     @default(now())

  reviewId  String
  review    Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([status])
  @@map("review_reports")
}

// ---------------------------------------------------------------------------
// AiConversation / AiMessage - persisted AI Travel Assistant chat history
// ---------------------------------------------------------------------------

model AiConversation {
  id        String   @id @default(uuid())
  title     String   @default("New conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages  AiMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid())
  role           AiRole
  content        String
  createdAt      DateTime @default(now())

  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("ai_messages")
}

// ---------------------------------------------------------------------------
// Notification - in-app notifications (bookings, payments, reminders, admin)
// ---------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// SearchLog - tracks user queries for "most searched" analytics
// ---------------------------------------------------------------------------

model SearchLog {
  id        String   @id @default(uuid())
  query     String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([query])
  @@map("search_logs")
}

// ---------------------------------------------------------------------------
// AiUsageLog - tracks AI feature usage for the analytics dashboard
// ---------------------------------------------------------------------------

model AiUsageLog {
  id        String   @id @default(uuid())
  type      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@map("ai_usage_logs")
}

// ---------------------------------------------------------------------------
// Booking
// ---------------------------------------------------------------------------

model Booking {
  id                String        @id @default(uuid())
  bookingId         String        @unique
  fullName          String
  email             String
  phone             String
  numberOfTravelers Int
  travelDate        DateTime
  returnDate        DateTime?
  budget            Float
  specialRequests   String?
  status            BookingStatus  @default(PENDING)
  paymentStatus     PaymentStatus  @default(PENDING)
  paymentId         String?
  orderId           String?
  amount            Float?
  currency          String?        @default("INR")
  paidAt            DateTime?
  paymentMethod     String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  destinationId     String
  destination       Destination   @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@unique([userId, destinationId, travelDate])
  @@index([userId])
  @@index([destinationId])
  @@index([status])
  @@index([paymentStatus])
  @@map("bookings")
}

// ---------------------------------------------------------------------------
// Hotel - discovery & booking for stays near each destination
// ---------------------------------------------------------------------------

model Hotel {
  id                    String      @id @default(uuid())
  slug                  String      @unique
  name                  String
  tagline               String
  description           String
  longDescription       String      @default("")
  image                 String
  gallery               String[]    @default([])
  starRating            Int         @default(3)
  rating                Float       @default(0)
  reviewsCount          Int         @default(0)
  popularityScore       Int         @default(0)
  priceFrom             Int
  hotelType             HotelType   @default(HOTEL)
  location              String
  latitude              Float?
  longitude             Float?
  distanceFromAttraction Float      @default(0)
  checkIn               String      @default("2:00 PM")
  checkOut              String      @default("11:00 AM")
  cancellationPolicy    String
  amenities             String[]    @default([])
  familyFriendly        Boolean     @default(false)
  coupleFriendly        Boolean     @default(false)
  freeBreakfast         Boolean     @default(false)
  freeWiFi              Boolean     @default(true)
  swimmingPool          Boolean     @default(false)
  parking               Boolean     @default(false)
  airConditioning       Boolean     @default(false)
  nearbyAttractions     String[]    @default([])
  nearbyRestaurants     String[]    @default([])
  nearbyTransport       String[]    @default([])
  isActive              Boolean     @default(true)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  rooms     HotelRoom[]
  bookings  HotelBooking[]
  reviews   HotelReview[]

  @@index([destinationId])
  @@index([hotelType])
  @@index([isActive])
  @@map("hotels")
}

model HotelRoom {
  id            String   @id @default(uuid())
  name          String
  description   String?
  pricePerNight Int
  maxGuests     Int      @default(2)
  bedType       String   @default("King")
  totalRooms    Int      @default(5)
  amenities     String[] @default([])
  images        String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  hotelId  String
  hotel    Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  bookings HotelBooking[]

  @@unique([hotelId, name])
  @@index([hotelId])
  @@map("hotel_rooms")
}

model HotelBooking {
  id             String            @id @default(uuid())
  bookingId      String            @unique
  checkIn        DateTime
  checkOut       DateTime
  guests         Int
  rooms          Int               @default(1)
  nights         Int
  pricePerNight  Int
  taxes          Int               @default(0)
  amount         Int
  fullName       String
  email          String
  phone          String
  specialRequests String?
  status         HotelBookingStatus @default(PENDING)
  paymentStatus  PaymentStatus     @default(PENDING)
  paymentId      String?
  orderId        String?
  paidAt         DateTime?
  paymentMethod  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  hotelId String
  hotel   Hotel @relation(fields: [hotelId], references: [id], onDelete: Restrict)

  roomId String
  room   HotelRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([hotelId])
  @@index([status])
  @@index([checkIn])
  @@map("hotel_bookings")
}

model HotelReview {
  id        String   @id @default(uuid())
  rating    Int
  comment   String
  images    String[] @default([])
  stayDate  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  hotelId String
  hotel   Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([userId, hotelId])
  @@index([hotelId])
  @@map("hotel_reviews")
}

// ---------------------------------------------------------------------------
// ContactMessage
// ---------------------------------------------------------------------------

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@map("contact_messages")
}

// ---------------------------------------------------------------------------
// Restaurant
// ---------------------------------------------------------------------------

enum RestaurantCategory {
  KERALA
  SEAFOOD
  VEGETARIAN
  CAFE
  FINE_DINING
  BAKERY
  FAST_FOOD
}

model Restaurant {
  id               String             @id @default(uuid())
  slug             String             @unique
  name             String
  tagline          String
  description      String
  longDescription  String             @default("")
  category         RestaurantCategory @default(KERALA)
  cuisines         String[]           @default([])
  priceRange       String
  priceLevel       Int                @default(2)
  openingHours     String
  phone            String?
  address          String
  city             String
  latitude         Float?
  longitude        Float?
  googleMapsUrl    String
  rating           Float              @default(0)
  ratingNote       String             @default("Sample rating")
  reviewsCount     Int                @default(0)
  popularityScore  Int                @default(0)
  bestFor          String[]           @default([])
  image            String
  gallery          String[]           @default([])
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([category])
  @@index([city])
  @@index([isActive])
  @@map("restaurants")
}

// ---------------------------------------------------------------------------
// Experience - curated local experiences across Kerala
// ---------------------------------------------------------------------------

enum ExperienceCategory {
  ADVENTURE
  CULTURE
  WILDLIFE
  FOOD
  WELLNESS
  NATURE
  WATER_ACTIVITIES
}

enum ExperienceDifficulty {
  EASY
  MODERATE
  CHALLENGING
}

model Experience {
  id               String               @id @default(uuid())
  slug             String               @unique
  name             String
  tagline          String
  description      String
  longDescription  String               @default("")
  category         ExperienceCategory   @default(NATURE)
  duration         String
  price            Int                  @default(0)
  location         String
  city             String
  latitude         Float?
  longitude        Float?
  difficulty       ExperienceDifficulty @default(EASY)
  bestSeason       String
  suitableFor      String[]             @default([])
  highlights       String[]             @default([])
  rating           Float                @default(0)
  ratingNote       String               @default("Sample rating")
  reviewsCount     Int                  @default(0)
  popularityScore  Int                  @default(0)
  isFeatured       Boolean              @default(false)
  image            String
  gallery          String[]             @default([])
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([category])
  @@index([city])
  @@index([isActive])
  @@map("experiences")
}

// ---------------------------------------------------------------------------
// PlannerTrip (Trip Planner 2.0 - hand-built multi-day itineraries)
// ---------------------------------------------------------------------------

model PlannerTrip {
  id        String   @id @default(uuid())
  title     String
  startDate DateTime?
  // PlannerDay[] as JSON: [{ id, title, notes, items: [{ id, type, refId, name,
  // city, location, latitude, longitude, image, price, rating, duration,
  // category, slug, href }] }] - a full snapshot so trips render even if the
  // source hotel/restaurant/destination/experience changes later.
  days      Json     @default("[]")
  // Packing checklist state: [{ label, checked }]
  packing   Json     @default("[]")
  // Public short code enabling read-only sharing without an account.
  shareCode String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("planner_trips")
}
